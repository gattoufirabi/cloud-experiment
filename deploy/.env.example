# Production settings. Copy to deploy/.env (mode 600) and fill in. Never commit .env.

# Console address; DNS A/AAAA record -> server IP
CONSOLE_HOST=console.example.com
# Client apps get <service>-<project>-<org>.<APPS_DOMAIN>; DNS: wildcard *.APPS_DOMAIN -> server IP.
# Use a separate domain from your main one, so abuse on client apps cannot hurt it.
APPS_DOMAIN=apps.example-cloud.net

# Database passwords: generate each with  openssl rand -base64 32
OWNER_DB_PASSWORD=
API_DB_PASSWORD=
AGENT_DB_PASSWORD=

# Image registry host clients push to; DNS A record -> server IP (HTTPS is automatic)
REGISTRY_HOST=registry.example-cloud.net
# Generate each with  openssl rand -hex 32
REGISTRY_INTERNAL_SECRET=
REGISTRY_EVENTS_SECRET=
TRIVY_TOKEN=

# Object storage (S3-compatible, Garage). S3 API at https://S3_HOST; public website buckets
# at <bucket>.web.<APPS_DOMAIN> (covered by the *.APPS_DOMAIN wildcard record).
S3_HOST=s3.apps.example-cloud.net
# Generate each with  openssl rand -hex 32
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
# Hosted mailboxes (mail server admin API, internal only): openssl rand -hex 24
STALWART_ADMIN_PASSWORD=
# Webmail address (a DNS name pointing to this server), for example webmail.example.com
WEBMAIL_HOST=

# Per-client backups, off-site: rest-server on a machine you own, e.g. over WireGuard.
#   BACKUP_REST_URL=rest:http://platform:<password>@10.8.0.3:8000
# Empty = repositories stay in the local platform-backups volume (NOT off-site).
BACKUP_REST_URL=

# Largest size a single client container may request
MAX_CPU_MILLIS=4000
MAX_MEMORY_MB=8192
