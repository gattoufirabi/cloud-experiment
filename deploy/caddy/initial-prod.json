{
  "admin": {
    "listen": "unix//run/caddy/admin.sock",
    "origins": [
      "caddy"
    ]
  },
  "logging": {
    "logs": {
      "default": {
        "exclude": [
          "http.log.access.tenant",
          "http.log.access.s3"
        ]
      },
      "tenant": {
        "writer": {
          "output": "stdout"
        },
        "encoder": {
          "format": "json"
        },
        "include": [
          "http.log.access.tenant"
        ]
      },
      "s3": {
        "writer": {
          "output": "stdout"
        },
        "encoder": {
          "format": "json"
        },
        "include": [
          "http.log.access.s3"
        ]
      }
    }
  }
}
