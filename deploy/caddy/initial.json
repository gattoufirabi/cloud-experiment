{
  "admin": {
    "listen": "unix//run/caddy/admin.sock",
    "origins": [
      "caddy"
    ]
  },
  "logging": {
    "logs": {
      "default": {
        "exclude": [
          "http.log.access.tenant",
          "http.log.access.s3"
        ]
      },
      "tenant": {
        "writer": {
          "output": "stdout"
        },
        "encoder": {
          "format": "json"
        },
        "include": [
          "http.log.access.tenant"
        ]
      },
      "s3": {
        "writer": {
          "output": "stdout"
        },
        "encoder": {
          "format": "json"
        },
        "include": [
          "http.log.access.s3"
        ]
      }
    }
  },
  "apps": {
    "http": {
      "servers": {
        "main": {
          "listen": [
            ":80"
          ],
          "automatic_https": {
            "disable": true
          },
          "routes": [
            {
              "match": [
                {
                  "host": [
                    "console.localhost"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "api:8080"
                    }
                  ]
                }
              ],
              "terminal": true
            }
          ]
        }
      }
    }
  }
}
